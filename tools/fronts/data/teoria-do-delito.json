    "css": ".cascade{width:100%;height:auto;display:block;border:1.5px solid var(--ink);background:var(--paper);box-shadow:6px 6px 0 var(--grid-major)}.cascade a rect{transition:fill .15s}.cascade a:hover rect,.cascade a:focus-visible rect{fill:var(--conc-wash)}.cascade text{font-family:var(--mono);font-size:12px;letter-spacing:.04em;fill:var(--ink)}.cascade .hdr{font:600 13px var(--mono);letter-spacing:.1em}.cascade .u{font:500 13px var(--sans);letter-spacing:0}.cascade .n{fill:var(--conc);font-weight:500}.cascade .ex{fill:var(--conc);font-size:11px}.cascade .sup text{fill:var(--ink-2);font-size:11.5px}.sheet-scroll{overflow-x:auto}.sheet-scroll .cascade{min-width:880px}.flowc-m{display:none}@media(max-width:720px) and (orientation:portrait){.sheet-scroll{display:none}.flowc-m{display:block;min-width:0!important}.flowc-m .u{font-size:12px}.flowc-m .sup text{font-size:10.5px}}.flowc .u{font-size:12.5px}.flowc .sup text{font-size:11px}.flowc .q{font:650 17px var(--sans);letter-spacing:0}.flowc .yn{font:600 12px var(--mono);letter-spacing:.06em}.flowc .out{font:600 14px var(--sans);letter-spacing:0;fill:var(--conc)}@media(max-width:860px) and (orientation:portrait){.front-note{display:block}}"
