  "exam_html": "<section class=\"front-row\" aria-label=\"Revisão\">\n  <aside class=\"exam-card\" aria-labelledby=\"exam-title\">\n    <h2 id=\"exam-title\">Revisão da P1</h2>\n    <p>Conteúdo até a imputação objetiva (unidades 01 a 07). P1 de 2025/2 resolvida, com questões e distinções para revisar.</p>\n    <a href=\"revisao-p1.html\"><span>Abrir revisão P1</span><span aria-hidden=\"true\">→</span></a>\n    <a class=\"resume\" href=\"#\" hidden><span>Continuar de onde parou</span><span aria-hidden=\"true\">→</span></a>\n  </aside>\n  <script>(function(){try{if(localStorage.getItem('ordenacoes-no-resume'))return;var d=JSON.parse(localStorage.getItem('ordenacoes-delito-last')||'null');if(!d||!/^(unidade|suplemento)-\\d\\d[a-z-]*\\.html$/.test(d.h))return;var a=document.querySelector('.exam-card .resume');a.href=d.h;a.firstChild.textContent='Continuar: '+String(d.t).slice(0,52);a.hidden=false}catch(e){}})()</script>\n</section>",
  "review_href": "revisao-p1.html",
  "units": [
    {
      "label": "Semanas 1–2",
      "title": "Quadro geral da teoria do crime",
      "desc": "Conceitos básicos.",
      "lessons": [
        {
          "href": "unidade-01.html",
          "label": "Aula 01",
          "title": "Conceito analítico e arquitetura do delito",
          "complementary": false,
          "reg": {
            "does": "Ordenar a análise penal pelos filtros da conduta à culpabilidade."
          }
        },
        {
          "href": "unidade-02.html",
          "label": "Aula 02",
          "title": "Conduta e modelos de ação",
          "complementary": false,
          "reg": {
            "does": "Comparar causalismo, finalismo e teoria social ao analisar a conduta."
          }
        },
        {
          "href": "suplemento-16.html",
          "label": "Leitura complementar",
          "title": "Teorias da conduta",
          "complementary": true,
          "reg": {
            "does": "Distinguir ação, omissão e resultado pelas teorias da conduta."
          }
        },
        {
          "href": "suplemento-17.html",
          "label": "Leitura complementar",
          "title": "Política criminal e método",
          "complementary": true,
          "reg": {
            "does": "Relacionar as funções das categorias penais a seus limites legais."
          }
        }
      ]
    },
    {
      "label": "Semanas 3–6",
      "title": "Teoria do tipo objetivo e subjetivo",
      "desc": "Dolo e culpa.",
      "lessons": [
        {
          "href": "unidade-03.html",
          "label": "Aula 03",
          "title": "Tipo e tipicidade objetiva",
          "complementary": false,
          "reg": {
            "does": "Verificar a tipicidade objetiva confrontando elementos do tipo e fatos provados."
          }
        },
        {
          "href": "unidade-04.html",
          "label": "Aula 04",
          "title": "Tipo subjetivo e dolo",
          "complementary": false,
          "reg": {
            "does": "Distinguir dolo eventual de culpa consciente pelos elementos de conhecimento e vontade."
          }
        },
        {
          "href": "unidade-05.html",
          "label": "Aula 05",
          "title": "Erro de tipo e classificação",
          "complementary": false,
          "reg": {
            "does": "Classificar o erro sobre elemento do tipo e determine seu efeito sobre o dolo."
          }
        },
        {
          "href": "unidade-06.html",
          "label": "Aula 06",
          "title": "Culpa e preterdolo",
          "complementary": false,
          "reg": {
            "does": "Imputar o resultado culposo pelo dever de cuidado, risco e nexo causal."
          }
        },
        {
          "href": "suplemento-18.html",
          "label": "Leitura complementar",
          "title": "Tipo, dever, omissão e imprudência",
          "complementary": true,
          "reg": {
            "does": "Analisar omissão e autoria conforme o tipo, o dever preexistente e a equivalência."
          }
        }
      ]
    },
    {
      "label": "Semanas 7–8",
      "title": "Nexo causal, imputação objetiva e tentativa",
      "desc": "Iter criminis e tentativa.",
      "lessons": [
        {
          "href": "unidade-07.html",
          "label": "Aula 07",
          "title": "Nexo causal e concausas",
          "complementary": false,
          "reg": {
            "does": "Examinar o nexo causal e a imputação objetiva diante de concausas."
          }
        },
        {
          "href": "unidade-08.html",
          "label": "Aula 08",
          "title": "Iter criminis e tentativa",
          "complementary": false,
          "reg": {
            "does": "Distinguir preparação, execução e consumação para reconhecer a tentativa."
          }
        }
      ]
    },
    {
      "label": "Semanas 9–10",
      "title": "Antijuridicidade e excludentes",
      "desc": "Causas de justificação.",
      "lessons": [
        {
          "href": "unidade-09.html",
          "label": "Aula 09",
          "title": "Antijuridicidade e normas de permissão",
          "complementary": false,
          "reg": {
            "does": "Identificar a permissão jurídica que afasta a antijuridicidade do fato típico."
          }
        },
        {
          "href": "unidade-10.html",
          "label": "Aula 10",
          "title": "Causas de justificação e seus limites",
          "complementary": false,
          "reg": {
            "does": "Avaliar os limites da justificante e a ocorrência de excesso no caso concreto."
          }
        },
        {
          "href": "suplemento-19.html",
          "label": "Leitura complementar",
          "title": "Justificação e conflito social",
          "complementary": true,
          "reg": {
            "does": "Reconstruir os princípios que fundamentam e limitam as permissões jurídicas."
          }
        }
      ]
    },
    {
      "label": "Semanas 11–13",
      "title": "Culpabilidade e excludentes",
      "desc": "Responsabilidade penal e causas de exclusão.",
      "lessons": [
        {
          "href": "unidade-11.html",
          "label": "Aula 11",
          "title": "Culpabilidade: conceito e teorias",
          "complementary": false,
          "reg": {
            "does": "Examinar se o injusto pode ser pessoalmente censurado ao agente."
          }
        },
        {
          "href": "unidade-12.html",
          "label": "Aula 12",
          "title": "Imputabilidade e capacidade pessoal",
          "complementary": false,
          "reg": {
            "does": "Avaliar a imputabilidade pelo efeito da condição mental na ação ou omissão."
          }
        },
        {
          "href": "unidade-13.html",
          "label": "Aula 13",
          "title": "Exigibilidade sob pressão",
          "complementary": false,
          "reg": {
            "does": "Examinar coação e obediência hierárquica para decidir se era exigível outra conduta."
          }
        },
        {
          "href": "suplemento-20.html",
          "label": "Leitura complementar",
          "title": "Culpabilidade e desistência",
          "complementary": true,
          "reg": {
            "does": "Relacionar culpabilidade, necessidade de pena e desistência no fato global."
          }
        }
      ]
    },
    {
      "label": "Semanas 14–15",
      "title": "Concurso de pessoas",
      "desc": "Autoria e participação.",
      "lessons": [
        {
          "href": "unidade-14.html",
          "label": "Aula 14",
          "title": "Autoria, coautoria e domínio do fato",
          "complementary": false,
          "reg": {
            "does": "Classificar autoria imediata, coautoria e autoria mediata pelo domínio do fato."
          }
        },
        {
          "href": "unidade-15.html",
          "label": "Aula 15",
          "title": "Participação e seus limites",
          "complementary": false,
          "reg": {
            "does": "Delimitar a participação e individualize a imputação conforme os arts. 29 a 31."
          }
        }
      ]
    }
  ],
