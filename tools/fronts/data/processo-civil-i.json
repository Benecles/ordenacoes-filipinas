  "exam_html": "<aside class=\"exam-card\" aria-labelledby=\"exam-title\"><span class=\"exam-date\">P1 · até a semana 9</span><h2 id=\"exam-title\">A passagem do programa</h2><p>A Primeira Avaliação fecha o bloco das semanas 1–9. A aferição final é cumulativa: acrescenta o conteúdo das semanas 11–16 ao percurso anterior. As datas do cronograma são provisórias e não aparecem aqui.</p><a href=\"revisao-p1.html\"><span>Abrir revisão</span><span aria-hidden=\"true\">→</span></a><a href=\"cartoes.html\"><span>Revisar com cartões</span><span aria-hidden=\"true\">→</span></a><a href=\"aula-01.html\"><span>Começar pela Aula 01</span><span aria-hidden=\"true\">→</span></a></aside>",
  "review_href": "revisao-p1.html",
  "units": [
    {
      "label": "Semana 01",
      "title": "Apresentação · fase de conhecimento · petição inicial",
      "desc": "Sem leitura específica indicada no cronograma.",
      "lessons": [
        {
          "href": "aula-01.html",
          "label": "Aula 01",
          "title": "Petição inicial, demanda e emenda",
          "complementary": false,
          "desc": "Delimitar a demanda e decidir o que deve ser corrigido na petição inicial.",
          "reg": {
            "does": "Delimitar a demanda e distinguir emenda de alteração do pedido."
          }
        }
      ]
    },
    {
      "label": "Semana 02",
      "title": "Aula reservada",
      "desc": "Sem leitura específica indicada no cronograma.",
      "lessons": []
    },
    {
      "label": "Semanas 03–04",
      "title": "Improcedência liminar, audiência, partes e litisconsórcio",
      "desc": "EID, Elie Pierre. Litisconsórcio Unitário: fundamentos, estrutura e regime. São Paulo: Revista dos Tribunais, 2016, p. 25–69.",
      "lessons": [
        {
          "href": "aula-02.html",
          "label": "Aula 02",
          "title": "Improcedência liminar e audiência inicial",
          "complementary": false,
          "desc": "Escolher a resposta judicial inicial e organizar a passagem para a audiência de conciliação ou mediação.",
          "reg": {
            "does": "Classificar a decisão inicial e identificar se cabe audiência."
          }
        },
        {
          "href": "aula-03.html",
          "label": "Aula 03",
          "title": "Partes e litisconsórcio",
          "complementary": false,
          "desc": "Identificar as partes e classificar a pluralidade de sujeitos pelos dois eixos do litisconsórcio.",
          "reg": {
            "does": "Classificar o litisconsórcio e identificar quem integra o polo."
          }
        }
      ]
    },
    {
      "label": "Semanas 05–06",
      "title": "Intervenção de terceiros",
      "desc": "CINTRA, Lia Carolina Batista. Intervenção de terceiro por ordem do juiz. Cap. 10: Análise crítica do sistema brasileiro vigente de intervenções de terceiro. São Paulo: Revista dos Tribunais, 2017.",
      "lessons": [
        {
          "href": "aula-04.html",
          "label": "Aula 04",
          "title": "Assistência simples e litisconsorcial",
          "complementary": false,
          "desc": "Identificar o interesse que permite a assistência e escolher o regime de participação do assistente.",
          "reg": {
            "does": "Relacionar o vínculo do assistente aos poderes que exerce."
          }
        },
        {
          "href": "aula-12.html",
          "label": "Aula 05",
          "title": "Denunciação da lide",
          "complementary": false,
          "desc": "Reconhecer a pretensão de garantia ou regresso e separar a demanda principal da demanda denunciada.",
          "reg": {
            "does": "Identificar quando cabe denunciação da lide."
          }
        },
        {
          "href": "aula-05.html",
          "label": "Aula 06",
          "title": "Chamamento, desconsideração e amicus curiae",
          "complementary": false,
          "desc": "Escolher entre chamamento, incidente de desconsideração e participação de amicus curiae segundo a função pretendida.",
          "reg": {
            "does": "Escolher a intervenção de terceiro conforme a relação envolvida."
          }
        }
      ]
    },
    {
      "label": "Semana 07",
      "title": "Comunicação, atos, cooperação e prazos",
      "desc": "Estudar modelos de documentos disponibilizados no Moodle.",
      "lessons": [
        {
          "href": "aula-06-citacao.html",
          "label": "Aula 07",
          "title": "Comunicação dos atos: citação e intimação",
          "complementary": false,
          "desc": "Ler AR, edital, mandado e certidão de nota de expediente e identificar o ato de comunicação registrado.",
          "reg": {
            "does": "Determinar a modalidade de citação e o marco de ciência."
          }
        },
        {
          "href": "aula-06.html",
          "label": "Aula 08",
          "title": "Atos processuais, processo eletrônico e cooperação",
          "complementary": false,
          "desc": "Escolher a forma, o lugar e o meio de prática do ato e reconhecer quando usar carta ou cooperação nacional.",
          "reg": {
            "does": "Classificar atos, negócios processuais e cartas."
          }
        },
        {
          "href": "aula-07.html",
          "label": "Aula 09",
          "title": "Prazos e preclusão",
          "complementary": false,
          "desc": "Fixar o termo inicial, contar o prazo e identificar quando o poder de praticar o ato se encerra.",
          "reg": {
            "does": "Calcular prazos úteis a partir do marco de comunicação aplicável."
          }
        }
      ]
    },
    {
      "label": "Semana 08",
      "title": "Resposta do réu",
      "desc": "DIDIER JR., Fredie. Curso de Direito Processual Civil. Vol. I. Salvador: Jus Podivm, 2015, p. 637–670.",
      "lessons": [
        {
          "href": "aula-08.html",
          "label": "Aula 10",
          "title": "Resposta do réu e contestação",
          "complementary": false,
          "desc": "Organizar a defesa na contestação e determinar quando ela deve ser apresentada.",
          "reg": {
            "does": "Estruturar a contestação e formular a defesa do réu."
          }
