  "exam_html": "<aside class=\"exam-card\" aria-labelledby=\"exam-title\">\n      <span class=\"exam-date\">Primeira prova</span>\n      <h2 id=\"exam-title\">Revisão para a P1</h2>\n      <p>Revisão das cinco unidades da prova, com artigos aplicáveis e dez casos resolvidos.</p>\n      <a href=\"revisao-p1.html\"><span>Abrir revisão P1</span><span aria-hidden=\"true\">→</span></a>\n      <a class=\"resume\" href=\"#\" hidden><span>Continuar de onde parou</span><span aria-hidden=\"true\">→</span></a>\n    </aside>\n<script>(function(){if(new Date()<new Date('2026-09-26T00:00:00-03:00'))return;var c=document.querySelector('.exam-card');if(!c)return;c.classList.add('p2');c.querySelector('.exam-date').textContent='Segunda prova';c.querySelector('h2').textContent='Revisão para a P2';c.querySelector('p').textContent='Interpretação, revisão, cessão e extinção, com artigos aplicáveis e doze casos resolvidos.';var a=c.querySelector('a:not(.resume)');a.href='revisao-p2.html';a.firstChild.textContent='Abrir revisão P2'})()</script>\n<script>(function(){try{if(localStorage.getItem('ordenacoes-no-resume'))return;var d=JSON.parse(localStorage.getItem('ordenacoes-contratos-last')||'null');if(!d||!/^\\d\\d$/.test(d.n))return;var a=document.querySelector('.exam-card .resume');a.href='aula-'+d.n+'.html';a.firstChild.textContent='Continuar: Aula '+d.n+' · '+String(d.t).slice(0,48);a.hidden=false}catch(e){}})()</script>",
